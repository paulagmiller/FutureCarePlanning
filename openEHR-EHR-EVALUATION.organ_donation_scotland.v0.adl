definition
	EVALUATION[at0000] matches {    -- Organ donation Scotland
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Consent to organ donation
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Donate all my organs and tissues
									at0004,    -- Opt out from organ donation
									at0005]    -- Choose which organs and tissue to donate
								}
							}
						}
					}
				}
			}
		}
	}

